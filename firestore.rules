rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.hostUid == request.auth.uid || resource.data.player2.uid == request.auth.uid);
      allow update: if request.auth != null && (resource.data.hostUid == request.auth.uid || resource.data.player2.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}